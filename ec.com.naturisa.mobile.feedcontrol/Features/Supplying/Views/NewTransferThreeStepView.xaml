<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ec.com.naturisa.mobile.feedcontrol.Features.Distribution.Views.NewTransferThreeStepView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:FeedTransferModels="clr-namespace:ec.com.naturisa.mobile.feedcontrol.Models.FeedTransfer"
    xmlns:controls="clr-namespace:ec.com.naturisa.mobile.feedcontrol.Controls"
    xmlns:distributionModels="clr-namespace:ec.com.naturisa.mobile.feedcontrol.Features.Distribution.Models"
    xmlns:models="clr-namespace:ec.com.naturisa.mobile.feedcontrol.Models"
    xmlns:viewModels="clr-namespace:ec.com.naturisa.mobile.feedcontrol.Features.Distribution.ViewModels"
    Padding="0"
    x:DataType="viewModels:NewTransferThreeStepViewModel"
    BackgroundColor="{StaticResource Secondary}"
    Shell.BackgroundColor="{StaticResource Secondary}">
    <Shell.TitleView>
        <Label Style="{StaticResource ShellTitleLabel}" Text="Nueva transferencia" />
    </Shell.TitleView>

    <Grid RowDefinitions="Auto, *" RowSpacing="16">
        <VerticalStackLayout
            Grid.Row="0"
            Padding="16"
            Spacing="8">
            <HorizontalStackLayout HorizontalOptions="CenterAndExpand" Spacing="6">
                <Label
                    FontSize="16"
                    HorizontalOptions="End"
                    Style="{StaticResource GoogleFont}"
                    Text="{x:Static models:IconFont.Preview}"
                    TextColor="{StaticResource OnSecondary}" />
                <Label
                    Style="{StaticResource RegularLabel}"
                    Text="Vista previa"
                    TextColor="{StaticResource OnSecondary}" />
            </HorizontalStackLayout>
            <Label
                HorizontalOptions="Center"
                Style="{StaticResource RegularLabel}"
                Text="{Binding LongDate}"
                TextColor="{StaticResource Primary900}" />
            <Grid
                Grid.Row="2"
                Margin="0,16,0,0"
                RowDefinitions="auto,auto"
                RowSpacing="8">
                <HorizontalStackLayout
                    Grid.Row="0"
                    HorizontalOptions="Center"
                    Spacing="8">
                    <Frame Style="{StaticResource SteperRoundFrame}">
                        <Label Style="{StaticResource SteperRoundLabel}" Text="1" />
                    </Frame>
                    <Label
                        FontSize="18"
                        Style="{StaticResource GoogleFont}"
                        Text="{x:Static models:IconFont.Arrow_right_alt}"
                        TextColor="{StaticResource OnSecondary}" />
                    <Frame Style="{StaticResource SteperRoundFrame}">
                        <Label Style="{StaticResource SteperRoundLabel}" Text="2" />
                    </Frame>
                    <Label
                        FontSize="18"
                        Style="{StaticResource GoogleFont}"
                        Text="{x:Static models:IconFont.Arrow_right_alt}"
                        TextColor="{StaticResource OnSecondary}" />
                    <Frame Style="{StaticResource SteperRoundAccentFrame}">
                        <Label Style="{StaticResource SteperRoundAccentLabel}" Text="3" />
                    </Frame>
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <Border
            Grid.Row="1"
            Padding="16,24,16,0"
            Style="{StaticResource RoundedWhiteBorder}">
            <Grid RowDefinitions="*">
                <Grid RowDefinitions="Auto, *" RowSpacing="16">
                    <Grid
                        ColumnDefinitions="120, *"
                        ColumnSpacing="8"
                        RowDefinitions="Auto, Auto, Auto"
                        RowSpacing="8">
                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="4">
                            <Label Text="Origen" TextColor="{StaticResource OnSecondary}" />
                            <Label
                                Style="{StaticResource RegularLabel}"
                                Text="Acopio Pezjoya"
                                TextColor="{StaticResource Primary700}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="4">
                            <Label Text="Destino" TextColor="{StaticResource OnSecondary}" />
                            <Label
                                Style="{StaticResource RegularLabel}"
                                Text="{Binding DestinationWarehouse.Name}"
                                TextColor="{StaticResource Primary700}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            Spacing="4">
                            <Label Text="Vehículo" TextColor="{StaticResource OnSecondary}" />
                            <Label
                                Style="{StaticResource RegularLabel}"
                                Text="{Binding SelectedTransport.NumberPlate}"
                                TextColor="{StaticResource Primary700}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="4">
                            <Label Text="Transportista" TextColor="{StaticResource OnSecondary}" />
                            <Label
                                Style="{StaticResource RegularLabel}"
                                Text="{Binding SelectedFreightTransporter.FullName}"
                                TextColor="{StaticResource Primary700}" />
                        </VerticalStackLayout>

                        <!--
                    <VerticalStackLayout
                        Grid.Row="2"
                        Grid.Column="0"
                        Spacing="4">
                        <Label Text="Capacidad" TextColor="{StaticResource OnSecondary}" />
                        <Label
                            Style="{StaticResource RegularLabel}"
                            Text="{Binding PoolTransferOneStepSelection.SelectedTransport.Plate}"
                            TextColor="{StaticResource Primary700}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="2"
                        Grid.Column="1"
                        Spacing="4">
                        <Label Text="Ayudantes" TextColor="{StaticResource OnSecondary}" />
                        <Label
                            Style="{StaticResource RegularLabel}"
                            Text="{Binding PoolTransferOneStepSelection.SelectedCarrier.Name}"
                            TextColor="{StaticResource Primary700}" />
                    </VerticalStackLayout>
                         ItemsSource="{Binding PoolTransferTwoStepSelectionModels}"
                        -->
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto, Auto">
                        <CollectionView Grid.Row="0" ItemsSource="{Binding ProductRows}">
                            <CollectionView.Header>
                                <Frame Padding="8" BackgroundColor="{StaticResource Secondary}">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <Label
                                            HorizontalOptions="Start"
                                            Text="Producto"
                                            TextColor="{StaticResource OnSecondary}" />
                                        <Label
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Text="Sacos"
                                            TextColor="{StaticResource OnSecondary}" />
                                    </Grid>
                                </Frame>
                            </CollectionView.Header>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="distributionModels:ProductDetail">
                                    <Grid
                                        Padding="8"
                                        BackgroundColor="{StaticResource Primary50}"
                                        ColumnDefinitions="*, Auto"
                                        ColumnSpacing="8">
                                        <VerticalStackLayout>
                                            <Label
                                                HorizontalOptions="Start"
                                                MaximumWidthRequest="300"
                                                Text="{Binding SelectedProduct.ProductName}"
                                                TextColor="{StaticResource Primary900}" />
                                            <Label
                                                FontSize="14"
                                                Text="{Binding SelectedProduct.ProductId, StringFormat='SKU {0:F0}'}"
                                                TextColor="{StaticResource OnSecondary}" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource RegularLabel}"
                                            Text="{Binding QuantitySacks}"
                                            TextColor="{StaticResource Primary700}"
                                            VerticalOptions="Start" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="*,*"
                            RowDefinitions="auto, auto">
                            <BoxView
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,8"
                                BackgroundColor="{StaticResource Gray200}"
                                HeightRequest="1" />

                            <Label
                                Grid.Row="4"
                                Grid.Column="0"
                                FontAttributes="None"
                                Text="TOTAL"
                                TextColor="{StaticResource OnSecondary}"
                                VerticalOptions="Start"
                                VerticalTextAlignment="Center" />
                            <StackLayout
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalOptions="End">
                                <Label
                                    HorizontalOptions="End"
                                    Text="{Binding TotalQuantitySacks, StringFormat='{}{0:N0} sacos'}"
                                    TextColor="{StaticResource Primary700}" />
                                <Label
                                    FontSize="14"
                                    HorizontalOptions="End"
                                    Text="{Binding TotalWeight, StringFormat='{}{0:N0} kg'}"
                                    TextColor="{StaticResource OnSecondary}" />
                            </StackLayout>
                        </Grid>
                    </Grid>
                </Grid>

                <controls:MainButtonControl
                    Command="{Binding CreateFarmTransferCommand}"
                    IsBusy="{Binding IsBusy}"
                    Text="Crear transferencia" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>