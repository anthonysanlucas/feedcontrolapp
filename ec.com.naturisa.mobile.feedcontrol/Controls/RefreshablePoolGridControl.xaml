<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ec.com.naturisa.mobile.feedcontrol.Controls.RefreshablePoolGridControl"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ec.com.naturisa.mobile.feedcontrol.Converters"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="RefreshablePoolGrid">
    <ContentView.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter" />
    </ContentView.Resources>

    <RefreshView Command="{Binding RefreshCommand, Source={x:Reference RefreshablePoolGrid}}" IsRefreshing="{Binding IsRefreshing, Source={x:Reference RefreshablePoolGrid}}">
        <CollectionView
            HorizontalOptions="FillAndExpand"
            ItemsSource="{Binding ItemsSource, Source={x:Reference RefreshablePoolGrid}}"
            SelectionMode="None"
            VerticalOptions="Start">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="6"
                    Orientation="Vertical"
                    Span="4"
                    VerticalItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Padding="0"
                        BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}, ConverterParameter=Status}"
                        BorderColor="{StaticResource Secondary}"
                        CornerRadius="8"
                        HeightRequest="84"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"
                        WidthRequest="84">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ItemTappedCommand, Source={x:Reference RefreshablePoolGrid}}" CommandParameter="{Binding}" />
                        </Frame.GestureRecognizers>
                        <Label
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource RegularLabel}"
                            Text="{Binding PoolCode}"
                            TextColor="{StaticResource White}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentView>
